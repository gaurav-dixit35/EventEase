<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="24dp">
        <com.google.android.material.appbar.MaterialToolbar android:id="@+id/organizer_login_toolbar"
            android:layout_width="match_parent" android:layout_height="?attr/actionBarSize"
            android:background="@color/primary" app:title="@string/organizer_login_title"
            app:titleTextColor="@color/on_primary" app:navigationIcon="@drawable/ic_back"
            app:navigationIconTint="@color/on_primary" app:navigationContentDescription="@string/back" />
        <include layout="@layout/view_brand" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:text="@string/organizer_login_title"
            android:textAppearance="@style/TextAppearance.EventEase.Heading" />
        <View android:layout_width="72dp" android:layout_height="1dp" android:layout_marginTop="12dp"
            android:background="@drawable/gold_divider" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:text="@string/organizer_login_subtitle"
            android:textAppearance="@style/TextAppearance.EventEase.Body" />
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="24dp" app:cardBackgroundColor="@color/primary">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="18dp">
                <com.google.android.material.textfield.TextInputLayout android:id="@+id/organizer_email_layout"
                    style="@style/Widget.MaterialComponents.TextInputLayout.FilledBox"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:hint="@string/organizer_email" app:boxBackgroundColor="@color/surface">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/organizer_email"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:inputType="textEmailAddress" android:singleLine="true" android:imeOptions="actionNext" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout android:id="@+id/organizer_password_layout"
                    style="@style/Widget.MaterialComponents.TextInputLayout.FilledBox"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" android:hint="@string/organizer_password"
                    app:boxBackgroundColor="@color/surface" app:endIconMode="password_toggle">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/organizer_password"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:inputType="textPassword" android:singleLine="true" android:imeOptions="actionDone" />
                </com.google.android.material.textfield.TextInputLayout>
                <TextView android:id="@+id/organizer_login_error" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="14dp"
                    android:textColor="@color/on_primary" android:visibility="gone"
                    android:accessibilityLiveRegion="polite" android:textAppearance="@style/TextAppearance.EventEase.Body" />
                <ProgressBar android:id="@+id/organizer_login_progress" android:layout_width="32dp"
                    android:layout_height="32dp" android:layout_gravity="center_horizontal"
                    android:layout_marginTop="16dp" android:visibility="gone" />
                <com.google.android.material.button.MaterialButton android:id="@+id/organizer_login_submit"
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp"
                    android:layout_marginTop="16dp" android:text="@string/organizer_login_submit"
                    app:strokeColor="@color/accent" app:strokeWidth="1dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.button.MaterialButton android:id="@+id/back_to_student_login"
            style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginTop="8dp"
            android:textAllCaps="false" android:text="@string/student_sign_in" />
    </LinearLayout>
</ScrollView>
