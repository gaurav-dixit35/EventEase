<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent"
    android:layout_height="match_parent" android:orientation="vertical">
    <com.google.android.material.appbar.MaterialToolbar android:id="@+id/organizer_dashboard_toolbar"
        android:layout_width="match_parent" android:layout_height="?attr/actionBarSize"
        android:background="@color/primary" app:title="@string/organizer_dashboard_title"
        app:titleTextColor="@color/on_primary" app:logo="@drawable/timscdr_crest_white" />
    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent"
        android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="20dp">
            <TextView android:id="@+id/organizer_welcome" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.EventEase.Heading" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:text="@string/organizer_dashboard_subtitle"
                android:textAppearance="@style/TextAppearance.EventEase.Body" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:text="@string/organizer_sync_status"
                android:textColor="@color/success" android:textSize="13sp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="20dp" android:orientation="horizontal">
                <com.google.android.material.card.MaterialCardView android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginEnd="6dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:padding="16dp">
                        <TextView android:id="@+id/stat_events" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:text="@string/number_zero"
                            android:textAppearance="@style/TextAppearance.EventEase.Heading" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:text="@string/organizer_total_events" android:textAppearance="@style/TextAppearance.EventEase.Body" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.card.MaterialCardView android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="6dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:padding="16dp">
                        <TextView android:id="@+id/stat_registrations" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:text="@string/number_zero"
                            android:textAppearance="@style/TextAppearance.EventEase.Heading" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:text="@string/organizer_total_registrations" android:textAppearance="@style/TextAppearance.EventEase.Body" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
            <com.google.android.material.card.MaterialCardView android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="12dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="16dp">
                    <TextView android:id="@+id/stat_checked_in" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:text="@string/number_zero"
                        android:textAppearance="@style/TextAppearance.EventEase.Heading" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="@string/organizer_total_checkins" android:textAppearance="@style/TextAppearance.EventEase.Body" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.button.MaterialButton android:id="@+id/create_organizer_event"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp"
                android:layout_marginTop="20dp" android:text="@string/create_event" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="28dp" android:text="@string/organizer_upcoming"
                android:textAppearance="@style/TextAppearance.EventEase.Heading" />
            <TextView android:id="@+id/organizer_events_empty" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="12dp"
                android:text="@string/organizer_empty_events" android:textAppearance="@style/TextAppearance.EventEase.Body"
                android:visibility="gone" />
            <ProgressBar android:id="@+id/organizer_events_progress" android:layout_width="36dp"
                android:layout_height="36dp" android:layout_gravity="center_horizontal" android:layout_marginTop="16dp" />
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/organizer_events_list"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:nestedScrollingEnabled="false"
                android:clipToPadding="false" android:paddingBottom="24dp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/organizer_sign_out"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginTop="12dp"
                android:layout_marginBottom="24dp" android:text="@string/organizer_sign_out" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
