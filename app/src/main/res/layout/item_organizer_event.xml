<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent"
    android:layout_height="wrap_content" android:layout_marginBottom="12dp" app:cardCornerRadius="10dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="16dp">
        <TextView android:id="@+id/organizer_event_name" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.EventEase.Heading" />
        <TextView android:id="@+id/organizer_event_meta" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="6dp"
            android:textAppearance="@style/TextAppearance.EventEase.Body" />
        <TextView android:id="@+id/organizer_event_registrations" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="12dp"
            android:textAppearance="@style/TextAppearance.EventEase.Body" />
        <TextView android:id="@+id/organizer_event_checkins" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="4dp"
            android:textAppearance="@style/TextAppearance.EventEase.Body" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton android:id="@+id/manage_attendees"
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:minHeight="44dp" android:text="@string/organizer_manage_attendees" android:textAllCaps="false" />
            <com.google.android.material.button.MaterialButton android:id="@+id/edit_event"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:minHeight="44dp" android:layout_marginStart="8dp"
                android:text="@string/organizer_edit_event" android:textAllCaps="false" />
        </LinearLayout>
        <com.google.android.material.button.MaterialButton android:id="@+id/delete_event"
            style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:minHeight="40dp" android:layout_gravity="end"
            android:text="@string/organizer_delete_event" android:textAllCaps="false" android:textColor="@color/error" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
